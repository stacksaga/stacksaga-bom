    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>org.stacksaga</groupId>
    <artifactId>stacksaga-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>StackSaga BOM</name>
    <description>Bill of Materials for StackSaga Spring Boot ecosystem dependencies</description>
    <url>https://github.com/stacksaga/stacksaga-bom</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>stacksaga</id>
            <name>StackSaga</name>
            <email>info@stacksaga.org</email>
            <organization>Zoftstack Lanka</organization>
            <organizationUrl>https://stacksaga.org</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/stacksaga/stacksaga-bom.git</connection>
        <developerConnection>scm:git:https://github.com/stacksaga/stacksaga-bom.git</developerConnection>
        <url>https://github.com/stacksaga/stacksaga-bom</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--        <spring-cloud.version>2025.1.2</spring-cloud.version>-->
        <org-javatuples.version>1.2</org-javatuples.version>
        <jnanoid.version>2.0.0</jnanoid.version>
        <swagger.annotations.jakarta>2.2.49</swagger.annotations.jakarta>
        <io.github.completabletuples.version>2.0.0</io.github.completabletuples.version>
        <cron-utils.version>9.1.6</cron-utils.version>

    </properties>

